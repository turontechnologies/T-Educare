# Base URL of the backend API — the same backend the admin app (frontend/) uses
NEXT_PUBLIC_API_URL=http://localhost:8081/api

# Public site URL, used for metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# The admin app's own URL — used for the "general sign-in page" link shown
# when an institution's slug can't be resolved
NEXT_PUBLIC_ADMIN_PORTAL_URL=http://localhost:3000
