# Base URL of the backend API consumed by src/lib/axios.ts
NEXT_PUBLIC_API_URL=http://localhost:8081/api

# Public site URL, used for metadata (src/config/site.ts)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the separate Student Portal app (student/), used to build each
# institution's "Student Portal URL" shown on /super-admin/institutions
NEXT_PUBLIC_STUDENT_PORTAL_URL=http://localhost:3001
